# Copy to .env and adjust. All variables use the DS_ prefix.
DS_APP_ENV=development
DS_LOG_LEVEL=INFO

# Relative SQLite paths are resolved from the repository root.
DS_DATABASE_URL=sqlite:///data/datasentinel.db
# PostgreSQL example (requires `pip install psycopg[binary]`):
# DS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/datasentinel

# Uploaded files are stored here (never in the database).
DS_STORAGE_DIR=data/storage

# Limits
DS_MAX_UPLOAD_MB=50
DS_MAX_ROWS=1000000
DS_MAX_COLUMNS=500
DS_PROFILE_SAMPLE_ROWS=200000
DS_MAX_PREVIEW_ROWS=100

# Comma-separated origins allowed to call the API (the Streamlit app).
DS_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Security (v10) ---------------------------------------------------------
# Require an API key on every call (health stays public). REQUIRED when DS_APP_ENV=production.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# DS_API_KEY=
# Optional second key that may only read (GET/HEAD).
# DS_READONLY_API_KEY=
# Rate limits per client (in-process, per worker). Format: N/second|minute|hour
DS_RATE_LIMIT_UPLOAD=10/minute
DS_RATE_LIMIT_ANALYSIS=30/minute
# Only true when a reverse proxy YOU control sets X-Forwarded-For.
DS_TRUST_PROXY_HEADERS=false
# Allow webhooks to private/internal addresses (local testing only; blocked in production).
DS_ALLOW_PRIVATE_WEBHOOKS=false
# Jobs queued/running longer than this at startup are marked failed (interrupted by restart).
DS_JOB_STALE_MINUTES=60
