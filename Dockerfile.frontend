# ── DataSentinel frontend (Streamlit) ───────────────────────────────────────
# Build: docker build -f Dockerfile.frontend -t datasentinel-frontend .
# Run:   docker run -p 8501:8501 -e DS_API_URL=http://backend:8000/api datasentinel-frontend

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DS_API_URL=http://localhost:8000/api

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

# Install backend deps first (shared), then frontend-only
COPY backend/requirements.txt ./backend-requirements.txt
COPY frontend/requirements.txt ./
RUN pip install --no-cache-dir -r backend-requirements.txt -r requirements.txt

COPY frontend/ ./frontend/
COPY .streamlit/ ./.streamlit/

CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')"
